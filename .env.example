# Salin menjadi .env lalu isi. Jangan pernah meng-commit .env.

# Alamat publik & jaringan
SIWAK_PUBLIC_URL=http://localhost:8080
HOST=127.0.0.1
PORT=8080

# MariaDB: mysql://pengguna:sandi@host:port/basisdata
DATABASE_URL=mysql://siwak:ganti-sandi@127.0.0.1:3306/siwak

# Folder berkas media (logo, foto, audio)
MEDIA_DIR=./media

# Google OAuth (Google Cloud Console > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenWeather (kunci khusus server)
OPENWEATHER_API_KEY=

# Rahasia acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
PIN_ENCRYPTION_KEY=

# Super admin pertama (dibuat otomatis saat server pertama kali jalan)
SUPERADMIN_EMAIL=

# Repo aplikasi TV, untuk tautan unduh APK terbaru
GITHUB_REPO=alfian-yds/siwak
