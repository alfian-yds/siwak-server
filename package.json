{
  "name": "siwak-server",
  "private": true,
  "version": "2.0.0",
  "description": "Server, admin web, dan situs SIWAK (Sistem Informasi Waktu Shalat)",
  "license": "MIT",
  "workspaces": [
    "api",
    "admin-web"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "npm run dev -w api",
    "build": "npm run build -w admin-web && npm run build -w api",
    "start": "npm run start -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w admin-web",
    "test": "npm run test -w api",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "license:check": "node scripts/check-licenses.mjs",
    "dev:web": "npm run dev -w admin-web",
    "license:list": "node scripts/check-licenses.mjs --list",
    "load-test": "npm run load-test -w api --",
    "panduan:pdf": "node scripts/panduan-pdf.mjs"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
